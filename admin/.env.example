# Copy to .env.local and fill in.
#
# The anon key is public by design — it authorises nothing on its own. Every
# table this console reads is behind row-level security, and agent access is
# granted by membership of support_agents, not by holding this key.
VITE_SUPABASE_URL=https://plannplate.supabase.co
VITE_SUPABASE_ANON_KEY=
