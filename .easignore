# Include everything from root .gitignore
node_modules/
.env*
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
.claude/
.gemini/
.expo/
dist/
web-build/
ios/
android/
.supabase/
graphify-out/

# Non-mobile project folders
admin/
backend/

# Huge patch and dump files
diff.patch
init.patch
*.docx
*.txt
*.jsonl

# Explicitly include mobile patches for patch-package
!mobile/patches/
!mobile/patches/**

